#: data/interfaces/bookstrap/users.html:50
#: data/interfaces/modern/users.html:113 data/interfaces/modern/users.html:115
msgid "Permissions"
msgstr "Права доступа"

#: data/interfaces/bookstrap/config.html:2773
#: data/interfaces/bookstrap/logs.html:53
#: data/interfaces/bookstrap/logs.html:68
msgid "File"
msgstr "Файл"

#: data/interfaces/bookstrap/config.html:2775
msgid "Directory"
msgstr "Папка"

#: data/interfaces/bookstrap/config.html:2778
msgid "Permissions should be 3 or 4 digits"
msgstr "Права доступа должны состоять из 3 или 4 цифр"

#: data/interfaces/bookstrap/config.html:2778
msgid "Defaults are File:644 Directory:755"
msgstr "По умолчанию: файл 644, папка 755"

#: data/interfaces/bookstrap/config.html:2781
msgid "Miscellaneous"
msgstr "Разное"

#: data/interfaces/bookstrap/config.html:2783
msgid "Cache expire after:"
msgstr "Срок хранения кэша:"

#: data/interfaces/bookstrap/config.html:2788
msgid ""
"How long the details fetched from the info sources are kept before they are "
"fetched again."
msgstr ""
"Сколько хранятся сведения, полученные из источников информации, прежде чем "
"будут запрошены снова."

#: data/interfaces/bookstrap/config.html:2791
msgid "Backup database every:"
msgstr "Резервное копирование базы данных каждые:"

#: data/interfaces/bookstrap/config.html:2796
msgid "How often a backup copy of the database is made."
msgstr "Как часто создаётся резервная копия базы данных."

#: data/interfaces/bookstrap/config.html:2800
msgid "Max Magazine Issue Age:"
msgstr "Макс. возраст выпуска журнала:"

#: data/interfaces/bookstrap/config.html:2805
msgid ""
"For a magazine you have no issues of yet, older issues than this are not "
"downloaded."
msgstr ""
"Для журнала, выпусков которого у вас ещё нет, более старые выпуски не "
"загружаются."

#: data/interfaces/bookstrap/config.html:2809
msgid "Remove failed tasks after:"
msgstr "Убирать неудачные задачи через:"

#: data/interfaces/bookstrap/config.html:2816
msgid "Abort stalled downloads after:"
msgstr "Прерывать зависшие загрузки через:"

#: data/interfaces/bookstrap/config.html:2819
msgid "Hours (0% progress)"
msgstr "Часы (0% прогресса)"

#: data/interfaces/bookstrap/config.html:2821
msgid "A download that makes no progress for this long is stopped."
msgstr "Загрузка, не продвигающаяся столько времени, останавливается."

#: data/interfaces/bookstrap/config.html:2824
msgid "Minimum seeders for torrent results:"
msgstr "Минимум сидов в результатах торрентов:"

#: data/interfaces/bookstrap/config.html:2829
msgid "Torrents with fewer seeders are left out, 0 turns this off."
msgstr "Торренты с меньшим числом сидов отбрасываются; 0 отключает проверку."

#: data/interfaces/bookstrap/config.html:2832
msgid "Search Match Ratio:"
msgstr "Порог совпадения при поиске:"

#: data/interfaces/bookstrap/config.html:2834
msgid "Search Match Ratio (percent)"
msgstr "Порог совпадения при поиске (проценты)"

#: data/interfaces/bookstrap/config.html:2837
msgid ""
"How alike (in percent) the title and author of a search result must be to a "
"book you want to count as a match. A lower number finds more, and more wrong "
"books too."
msgstr ""
"Насколько (в процентах) название и автор результата поиска должны совпадать "
"с нужной книгой, чтобы считаться совпадением. Чем ниже число, тем больше "
"находится - в том числе и неправильных книг."

#: data/interfaces/bookstrap/config.html:2840
msgid "Download Match Ratio:"
msgstr "Порог совпадения при загрузке:"

#: data/interfaces/bookstrap/config.html:2842
msgid "Download Match Ratio (percent)"
msgstr "Порог совпадения при загрузке (проценты)"

#: data/interfaces/bookstrap/config.html:2845
msgid ""
"How alike (in percent) the name of a downloaded file must be to the book for "
"it to be imported."
msgstr ""
"Насколько (в процентах) имя загруженного файла должно совпадать с книгой, "
"чтобы её импортировать."

#: data/interfaces/bookstrap/config.html:2848
msgid "Provider Priority Weighting:"
msgstr "Вес приоритета провайдера:"

#: data/interfaces/bookstrap/config.html:2850
msgid "Priority weight"
msgstr "Вес приоритета"

#: data/interfaces/bookstrap/config.html:2851
msgid "Multiplier"
msgstr "Множитель"

#: data/interfaces/bookstrap/config.html:2853
msgid ""
"0 = prefer match percentage. Higher values make downloader priority more "
"important when selecting \"best\" match"
msgstr ""
"0 = предпочитать процент совпадения. Чем больше значение, тем важнее "
"приоритет загрузчика при выборе «лучшего» совпадения"

#: data/interfaces/bookstrap/config.html:2856
msgid "Maximum Search Pages:"
msgstr "Макс. страниц поиска:"

#: data/interfaces/bookstrap/config.html:2857
#: data/interfaces/bookstrap/config.html:2862
#: data/interfaces/bookstrap/config.html:2867
msgid "0 for no limit"
msgstr "0 - без ограничений"

#: data/interfaces/bookstrap/config.html:2858
msgid ""
"How many pages of results are read from a provider in one search, 0 for all "
"of them."
msgstr ""
"Сколько страниц результатов читается у провайдера за один поиск; 0 - все."

#: data/interfaces/bookstrap/config.html:2861
msgid "Maximum Author Pages:"
msgstr "Макс. страниц автора:"

#: data/interfaces/bookstrap/config.html:2863
msgid ""
"How many pages of the book list of an author are read from the info source, "
"0 for all of them."
msgstr ""
"Сколько страниц списка книг автора читается из источника информации; 0 - все."

#: data/interfaces/bookstrap/config.html:2866
msgid "Maximum Coverwall Images:"
msgstr "Макс. изображений на стене обложек:"

#: data/interfaces/bookstrap/config.html:2868
msgid "How many covers the Cover Wall shows at most."
msgstr "Сколько обложек максимум показывает стена обложек."

#: data/interfaces/bookstrap/config.html:2875
msgid "Cover creation program:"
msgstr "Программа создания обложек:"

#: data/interfaces/bookstrap/config.html:2876
msgid "Cover creation program"
msgstr "Программа создания обложек"

#: data/interfaces/bookstrap/config.html:2877
msgid ""
"Program for creating magazine covers (see wiki for details) Leave blank to "
"use a local copy of ghostscript, or PythonMagick or Wand interfaces to "
"ImageMagick"
msgstr ""
"Программа для создания обложек журналов (подробнее см. вики). Оставьте "
"пустым, чтобы использовать локальную копию ghostscript или интерфейсы "
"PythonMagick или Wand к ImageMagick"

#: data/interfaces/bookstrap/config.html:2883
msgid "Create cover files for magazines"
msgstr "Создавать файлы обложек для журналов"

#: data/interfaces/bookstrap/config.html:2884
msgid "Saves the first page of each issue as its cover picture."
