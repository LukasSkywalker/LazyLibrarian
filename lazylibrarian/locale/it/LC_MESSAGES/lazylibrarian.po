msgid ""
"Automatic searches the Import languages above. Magazines and comics are "
"searched in all languages."
msgstr ""
"Automatico cerca nelle lingue di importazione indicate sopra. Riviste e "
"fumetti vengono cercati in tutte le lingue."

#: data/interfaces/bookstrap/config.html:4092
msgid "GoogleBooks Country:"
msgstr "Paese GoogleBooks:"

